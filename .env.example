DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required once deployed on a real domain, or POSTs fail CSRF validation.
# MUST include the scheme; a bare hostname raises ImproperlyConfigured.
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://buyback.example.com,https://www.buyback.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set to 1 only when a reverse proxy terminates TLS in front of the app.
# It makes Django trust X-Forwarded-Proto; if the app is reachable directly,
# a client could forge that header.
DJANGO_BEHIND_TLS_PROXY=0

# Set to 1 when served over HTTPS. Marking cookies Secure over plain HTTP
# makes them undeliverable and locks you out of the admin.
DJANGO_SECURE_COOKIES=0

POSTGRES_DB=buyback
POSTGRES_USER=buyback
POSTGRES_PASSWORD=buyback
DATABASE_URL=postgresql://buyback:buyback@db:5432/buyback

JANICE_API_KEY=your-janice-api-key
JANICE_BASE_URL=https://janice.e-351.com/api/rest/v2
